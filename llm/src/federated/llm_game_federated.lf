target Python { keepalive: true }

import LlmA, LlmB, Judge from "llm_base_class_federate_in.lf"

federated reactor llm_game_federated at 10.218.100.78 {
  j    = new Judge()
  llma = new LlmA()
  llmb = new LlmB()

  j.ask -> llma.user_in
  j.ask -> llmb.user_in

  llma.answer -> j.llma
  llmb.answer -> j.llmb

  llma.ready_out -> j.ready_a
  llmb.ready_out -> j.ready_b
}
