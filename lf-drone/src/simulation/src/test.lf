target C   // runs until Ctrl+C

import CSV_reader from "CSV_reader.lf"
import AvoidPlanner from "avoid_planner_modal.lf"
import DebugRcPrinter from "DebugRcPrinter.lf"
import UserLandCmd from "/mnt/e/PhD/lf-demos/lf-drone/lib/UserLandCmd.lf"

main reactor test {
  csv = new CSV_reader(
    path="/mnt/e/PhD/lf-demos/lf-drone/src/simulation/data/tof_20260211_133454.csv",
    period=20 ms
  )

  avoid = new AvoidPlanner()

  dbg = new DebugRcPrinter(
    out_path="/mnt/e/PhD/lf-demos/lf-drone/src/simulation/results/rc_out.csv"
  )

  land_cmd = new UserLandCmd()

  csv.front  -> avoid.front
  csv.left   -> avoid.left
  csv.right  -> avoid.right
  csv.bottom -> avoid.bottom
  csv.top    -> avoid.top

  land_cmd.out -> avoid.land

  csv.step -> dbg.step

  avoid.roll     -> dbg.roll
  avoid.pitch    -> dbg.pitch
  avoid.yaw      -> dbg.yaw
  avoid.throttle -> dbg.throttle
  avoid.aux1     -> dbg.aux1
  avoid.aux2     -> dbg.aux2
}