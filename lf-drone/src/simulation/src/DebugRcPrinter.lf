target C

preamble {=
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <errno.h>

static void ensure_parent_dir(const char* path) {
  char dir[512];
  strncpy(dir, path, sizeof(dir) - 1);
  dir[sizeof(dir) - 1] = '\0';

  char* slash = strrchr(dir, '/');
  if (!slash) return;

  *slash = '\0';

  char cmd[600];
  snprintf(cmd, sizeof(cmd), "mkdir -p \"%s\"", dir);
  system(cmd);
}
=}

reactor DebugRcPrinter(out_path:string="./src/simulation/results/rc_out.csv") {
  input step: int

  input roll:int
  input pitch:int
  input yaw:int
  input throttle:int
  input aux1:int
  input aux2:int

  state fp: FILE*

  state rr: int = 1500
  state pp: int = 1500
  state yy: int = 1500
  state thr: int = 1000
  state a1: int = 1000
  state a2: int = 1000

  reaction(startup) {=
    ensure_parent_dir(self->out_path);

    self->fp = fopen(self->out_path, "w");
    if (!self->fp) {
      fprintf(stderr, "[DebugRcPrinter] Failed to open %s\n", self->out_path);
      return;
    }

    fprintf(self->fp, "step,roll,pitch,yaw,throttle,aux1,aux2\n");
    fflush(self->fp);
  =}

  reaction(shutdown) {=
    if (self->fp) fclose(self->fp);
    self->fp = NULL;
  =}

  reaction(roll)     {= self->rr  = roll->value; =}
  reaction(pitch)    {= self->pp  = pitch->value; =}
  reaction(yaw)      {= self->yy  = yaw->value; =}
  reaction(throttle) {= self->thr = throttle->value; =}
  reaction(aux1)     {= self->a1  = aux1->value; =}
  reaction(aux2)     {= self->a2  = aux2->value; =}

  reaction(step) {=
    if (!self->fp) return;

    fprintf(self->fp, "%d,%d,%d,%d,%d,%d,%d\n",
      step->value,
      self->rr, self->pp, self->yy, self->thr, self->a1, self->a2
    );
    fflush(self->fp);
  =}
}