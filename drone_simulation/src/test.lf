target C   // runs until Ctrl+C

import CSV_reader from "CSV_reader.lf"
import AvoidPlanner from "avoid_planner_modal.lf"
import DebugRcPrinter from "DebugRcPrinter.lf"
import UserLandCmd from "UserLandCmd.lf"

main reactor test {
  // ToF sensors (use the exact buses/addresses that work for you)
  csv = new CSV_reader(path="src/tof_20260211_133454.csv", period=20 ms)

  avoid  = new AvoidPlanner()
  dbg   = new DebugRcPrinter(out_path="rc_out.csv")

  // Keyboard landing trigger
  land_cmd = new UserLandCmd()

  // sensors -> planner
  csv.front  -> avoid.front
  csv.left   -> avoid.left
  csv.right  -> avoid.right
  csv.bottom -> avoid.bottom
  csv.top    -> avoid.top

  // landing command
  csv.step -> dbg.step

  // planner -> MSP
  avoid.roll     -> dbg.roll
  avoid.pitch    -> dbg.pitch
  avoid.yaw      -> dbg.yaw
  avoid.throttle -> dbg.throttle
  avoid.aux1     -> dbg.aux1
  avoid.aux2     -> dbg.aux2
}