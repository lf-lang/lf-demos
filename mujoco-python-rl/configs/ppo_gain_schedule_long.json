  "model_variation_frac": 0.1,
  "disturbance_count_range": [0, 10],
  "noise_std": 0.0,
  "delay_steps": 0,
  "learning_rate": 0.0002,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_coef": 0.2,
  "entropy_coef": 0.006,
  "value_coef": 0.5,
  "max_grad_norm": 0.5,
  "update_epochs": 6,
  "minibatch_size": 256,
  "hidden_sizes": [128, 128],
  "kp_max": 60.0,
  "ki_max": 6.0,
  "kd_max": 6.0,
  "kaw_max": 1.5,
  "torque_weight": 0.04,
  "saturation_weight": 0.5,
  "gain_magnitude_weight": 0.03,
  "gain_rate_weight": 0.02,
  "checkpoint_path": "training/checkpoints/ppo_gain_schedule_long.pt",
  "episode_log_path": "training/logs/ppo_gain_schedule_long_episodes.csv",
  "update_log_path": "training/logs/ppo_gain_schedule_long_updates.csv"
}
