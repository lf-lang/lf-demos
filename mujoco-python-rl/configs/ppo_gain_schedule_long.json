{
  "seed": 0,
  "total_timesteps": 100000,
  "rollout_steps": 2048,
  "episode_steps": 2000,
  "policy_interval_steps": 5,
  "task_names": ["trajectory", "pose", "sinusoid"],
  "task_probs": [0.5, 0.25, 0.25],
  "random_gravity": true,
  "random_tilt": true,
  "vary_model": true,
  "gravity_mag_range": [7.0, 13.0],
