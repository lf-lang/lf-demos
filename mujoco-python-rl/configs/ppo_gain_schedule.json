{
  "seed": 0,
  "total_timesteps": 20000,
  "rollout_steps": 1024,
  "episode_steps": 2000,
  "policy_interval_steps": 5,
  "task_names": ["trajectory", "pose", "sinusoid"],
  "task_probs": [0.5, 0.25, 0.25],
  "random_gravity": true,
  "random_tilt": true,
  "vary_model": true,
  "gravity_mag_range": [7.0, 13.0],
  "tilt_xy_range": [-0.5, 0.5],
  "model_variation_frac": 0.1,
  "disturbance_count_range": [0, 10],
  "noise_std": 0.0,
  "delay_steps": 0,
  "learning_rate": 0.0003,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_coef": 0.2,
  "entropy_coef": 0.01,
  "value_coef": 0.5,
  "max_grad_norm": 0.5,
  "update_epochs": 5,
  "minibatch_size": 256,
  "hidden_sizes": [128, 128],
  "checkpoint_path": "training/checkpoints/ppo_gain_schedule.pt",
  "episode_log_path": "training/logs/ppo_gain_schedule_episodes.csv",
  "update_log_path": "training/logs/ppo_gain_schedule_updates.csv"
}
