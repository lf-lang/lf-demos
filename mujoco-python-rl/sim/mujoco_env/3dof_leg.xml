<mujoco model="scene_with_3dof_leg">

  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1=".1 .2 .3" rgb2=".2 .3 .4"
             width="300" height="300"/>
    <material name="grid" texture="grid"
              texrepeat="1 1" texuniform="true"
              reflectance=".2"/>
  </asset>

  <worldbody>

    <light pos="0 0 1"/>
    <geom name="floor" type="plane"
          pos="0 0 -.5" size="2 2 .1"
          material="grid"
          friction="1.0 0.005 0.0001"/>

    <camera name="fixed" pos="0 -1.3 .5" xyaxes="1 0 0 0 1 2"/>

    <body name="leg_chassis" pos="0 0 0.0">
      <inertial pos="0 0 0" mass="0.5"
                diaginertia="0.002 0.002 0.002"/>

      <geom type="box" size="0.05 0.02 0.05"
            rgba="0.6 0.6 0.6 1"/>

      <body name="hip" pos="-0.06 0 0">

        <joint name="hip_joint"
               type="hinge"
               axis="0 0 1"
               range="-0.78 0.78"
               damping="0.2"/>

        <inertial pos="-0.025 0 0" mass="0.2"
                  diaginertia="0.0005 0.0005 0.0005"/>

        <geom type="capsule"
              fromto="0 0 0 -0.05 0 0"
              size="0.025"
              rgba="0.8 0.2 0.2 1"/>

        <body name="thigh" pos="-0.05 0.045 0">

          <joint name="knee_joint"
                 type="hinge"
                 axis="0 1 0"
                 range="0.0 3.14"
                 damping="0.2"/>

          <inertial pos="0 0 -0.125" mass="0.4"
                    diaginertia="0.003 0.003 0.001"/>

          <geom type="capsule"
                fromto="0 0 0 0 0 -0.20"
                size="0.025"
                rgba="0.2 0.8 0.2 1"/>

          <body name="ankle" pos="0 -0.045 -0.20">

            <joint name="ankle_joint"
                   type="hinge"
                   axis="0 1 0"
                   range="-2.1 2.1"
                   damping="0.2"/>

            <inertial pos="0 0 -0.10" mass="0.3"
                      diaginertia="0.002 0.002 0.0008"/>

            <geom type="capsule"
                  fromto="0 0 0 0 0 -0.20"
                  size="0.025"
                  rgba="0.2 0.2 0.8 1"/>

            <body name="foot" pos="0 0 -0.225">
              <inertial pos="0 0 0" mass="0.1"
                        diaginertia="0.0002 0.0002 0.0002"/>

              <geom type="sphere"
                    size="0.04"
                    friction="1.2 0.005 0.0001"
                    rgba="0.2 0.2 0.8 1"/>
              <site name="ee_site"
                    pos="0 0 -0.04"
                    size="0.01"
                    rgba="1 0 0 1"/>
            </body>

          </body>
        </body>
      </body>
    </body>

  </worldbody>

  <actuator>
    <motor name="hip_motor"   joint="hip_joint"   gear="15" ctrlrange="-1 1"/>
    <motor name="knee_motor"  joint="knee_joint"  gear="5" ctrlrange="-1 1"/>
    <motor name="ankle_motor" joint="ankle_joint" gear="5" ctrlrange="-1 1"/>
  </actuator>

</mujoco>
