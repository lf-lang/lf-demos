target Python {
    keepalive: true
}

preamble{=
    import numpy as np
=}

# this reactor defines an open loop controller for validating plant
reactor OpenLoopController{

    input control_trigger
    output torque

    # init torque command
    reaction(startup) -> torque {=
        torque.set(np.zeros(3))
    =}

    # on receiving a trigger from the control timer, output a torque
    reaction(control_trigger) -> torque{=
        torque.set(np.full(3, 0.4))
    =}
}
